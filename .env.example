# Copy this file to .env and fill in your own values.
# .env is git-ignored — never commit real keys or endpoints.

# LiteLLM gateway (local setup)
LITELLM_BASE_URL=http://localhost:4000
LITELLM_API_KEY=

# Ollama (local model host)
OLLAMA_BASE_URL=http://localhost:11434

# Which local model to use as the "thing being tested"
ERRATA_MODEL_NAME=llama3.2
